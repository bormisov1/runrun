{
  "expo": {
    "name": "RUNRUN",
    "slug": "runrun",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "runrun",
    "ios": {
      "bundleIdentifier": "com.bormisov.runrun",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.bormisov.runrun",
      "adaptiveIcon": {
        "backgroundColor": "#070A0E",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "RUNRUN uses your location to record runs and your last 24 hours of routes.",
          "locationAlwaysAndWhenInUsePermission": "RUNRUN saves your last 24 hours of routes even while the app is closed, so you can create an activity later. You can turn this off in Settings.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "RUNRUN needs the camera to capture your run.",
          "microphonePermission": "RUNRUN needs the microphone to record video audio.",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-media-library",
        {
          "savePhotosPermission": "RUNRUN saves your run photos and videos.",
          "granularPermissions": []
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#070A0E",
          "image": "./assets/splash-mark.png",
          "imageWidth": 220
        }
      ],
      "expo-sharing",
      "expo-status-bar",
      "expo-font",
      "expo-maps"
    ],
    "extra": {
      "eas": {
        "projectId": "61384423-0d21-4719-ab78-338a487a076a"
      }
    },
    "owner": "bormisov"
  }
}
